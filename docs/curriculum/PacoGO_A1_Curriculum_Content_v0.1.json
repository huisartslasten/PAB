  "skill_id": "A1",
  "name": "Getallen representeren en verbinden",
  "purpose": "Reference curriculum slice for turning the scientific A1 registry definition into reusable learning interactions without hard-coding a lesson-specific interface.",
  "developments": [
    {
      "id": "A1.D1",
      "focus": "Representational meaning",
      "required_interaction_forms": ["identify", "place", "match", "explain"],
      "primary_interfaces": ["quantity-representation", "number-line"],
      "evidence_targets": ["A1.ET1"],
      "content_principles": [
        "Use multiple representations of the same numerical value.",
        "Require the learner to connect representation with quantity or position.",
        "Capture the learner action, not only the final answer.",
        "Avoid treating a correct answer alone as proof of conceptual understanding."
      ]
    },
    {
      "id": "A1.D2",
      "focus": "Mapping",
      "required_interaction_forms": ["match", "transform", "compare", "explain"],
      "primary_interfaces": ["quantity-representation", "number-line"],
      "evidence_targets": ["A1.ET2", "A1.ET4"],
      "content_principles": [
        "Move between representations while preserving the underlying value.",
        "Vary surface form so familiarity cannot substitute for the target relation.",
        "Capture whether the learner preserves the invariant numerical value."
      ]
    },
    {
      "id": "A1.D3",
      "focus": "Coordination",
      "required_interaction_forms": ["select", "combine", "translate", "justify"],
      "primary_interfaces": ["quantity-representation", "number-line"],
      "evidence_targets": ["A1.ET3", "A1.ET5"],
      "content_principles": [
        "Require coordination of more than two representations where appropriate.",
        "Allow the learner to choose or combine representations.",
        "Distinguish independent coordination from prompted completion."
      ]
    }
  ],
