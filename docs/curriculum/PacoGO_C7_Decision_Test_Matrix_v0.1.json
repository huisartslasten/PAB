{
  "protocol_id": "C7-NEXT-ACTION-DECISION",
  "version": "0.1",
  "status": "candidate_validation_matrix",
  "purpose": "Deterministic validation matrix for C7 candidate next-action decisions.",
  "safety": {
    "registry_promotion_allowed": false,
    "runtime_state_mutation_allowed": false,
    "automatic_learner_advancement_allowed": false,
    "automatic_mastery_write_allowed": false
  },
  "base_context": {
    "claim_id": "A1.C1",
