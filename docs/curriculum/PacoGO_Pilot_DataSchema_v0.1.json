{
  "schema_version": "0.1",
  "status": "candidate",
  "unit": "Student × Time × Task × Response × Evidence",
  "purpose": "C2 student data provenance for empirical curriculum validation",
  "required_fields": {
    "observation_id": "string",
    "student_key": "string",
    "session_id": "string",
    "observed_at": "timestamp",
    "curriculum_registry_version": "string",
    "skill_id": "string",
    "development_id": "string|null",
    "claim_id": "string|null",
    "evidence_target_id": "string|null",
    "task_model_id": "string|null",
    "task_instance_id": "string",
    "performance": "object",
    "context": "object",
    "provenance": "object"
  },
  "performance": {
    "response": "object|null",
    "correctness": "number|null",
    "response_time_ms": "number|null",
    "attempts": "number|null",
    "hints": "array",
    "strategy": "object|null",
    "explanation": "object|null",
    "representation": "object|null"
  },
  "context": {
    "language": "string|null",
    "setting": "string|null",
    "prompt_level": "string|null",
    "task_variant": "string|null",
    "variation_key": "string|null",
    "notes": "string|null"
  },
  "provenance": {
    "source": "string",
    "source_event_id": "string|null",
    "task_definition_version": "string",
    "collector_version": "string",
    "coder_version": "string|null",
    "coder_id": "string|null"
  },
  "coding": {
    "evidence_status": "PRESENT|ABSENT|INDETERMINATE|NOT_CODED",
    "evidence_target_match": "MATCH|MISMATCH|UNCLEAR|NOT_CODED",
    "quality": "number|null",
    "independence": "INDEPENDENT|PROMPTED|DEPENDENT|UNKNOWN",
    "contradiction": "boolean|null",
    "alternative_explanations": "array",
    "coder_note": "string|null"
  },
  "privacy": {
    "student_key_must_be_pseudonymous": true,
    "direct_identifiers_outside_this_schema": true,
    "minimum_necessary_data": true
  },
  "integrity_rules": [
    "Every observation has exactly one curriculum registry version.",
    "Every task instance resolves to a task model version.",
    "Observed data are immutable; corrections create a new versioned coding record.",
    "Development inference is not stored as raw performance.",
    "Missingness is represented explicitly and is never silently converted to failure.",
    "A correct response does not by itself establish developmental support."
  ]
}
